# ==========================================
# 67movies Environment Variables
# ==========================================

# Database & Cache (Docker compose defaults)
DATABASE_URL="postgresql://cinemaflow:cinemaflow_secret@localhost:5432/cinemaflow?schema=public"
REDIS_URL="redis://localhost:6379"

# API Server Configuration
PORT=4000
API_PREFIX="api"
CORS_ORIGIN="http://localhost:3000"
JWT_SECRET="67movies_super_secret_jwt_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Stream & CORS Proxy
STREAM_PROXY_PORT=4000
STREAM_PROXY_SECRET="proxy_signature_key_2026"

# TMDB API (Server-side metadata integration)
# Get your free key at: https://www.themoviedb.org/settings/api
# Works with both API Key (v3) or API Read Access Token (v4)
TMDB_API_KEY=""
TMDB_BASE_URL="https://api.themoviedb.org/3"
TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_STREAM_PROXY_URL="http://localhost:4000/api/proxy"
NEXT_PUBLIC_APP_NAME="67movies"
